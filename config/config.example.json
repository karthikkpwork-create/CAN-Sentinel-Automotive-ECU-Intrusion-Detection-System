{
  "description": "Synthetic lab configuration. ECU names, CAN IDs and payload layouts are INVENTED for this project and are not taken from any real vehicle.",
  "interface": "vcan0",
  "runtime_seconds": 30,
  "random_seed": 42,
  "rate_scale": 1.0,
  "jitter_percent": 2.0,
  "log_level": "INFO",
  "log_file": "logs/simulator.log",
  "monitor_log_file": "logs/monitor.log",
  "sender_log_path": "data/generated/sender_log.csv",
  "observed_dataset_path": "data/generated/observed_normal_traffic.csv",
  "ecus": [
    {
      "name": "engine_ecu",
      "messages": [
        {
          "name": "engine_status",
          "can_id": "0x100",
          "interval_ms": 100,
          "dlc": 8,
          "signals": [
            {"name": "rpm", "start_byte": 0, "size": 2, "initial": 850, "min": 750, "max": 3500, "max_step": 30},
            {"name": "throttle_pct", "start_byte": 2, "size": 1, "initial": 15, "min": 0, "max": 100, "max_step": 2},
            {"name": "engine_load_pct", "start_byte": 3, "size": 1, "initial": 25, "min": 0, "max": 100, "max_step": 2}
          ],
          "counter_byte": 7
        }
      ]
    },
    {
      "name": "dashboard_ecu",
      "messages": [
        {
          "name": "dashboard_status",
          "can_id": "0x200",
          "interval_ms": 200,
          "dlc": 4,
          "signals": [
            {"name": "speed_kph", "start_byte": 0, "size": 1, "initial": 0, "min": 0, "max": 180, "max_step": 3},
            {"name": "fuel_pct", "start_byte": 1, "size": 1, "initial": 70, "min": 0, "max": 100, "max_step": 1}
          ],
          "counter_byte": 3
        }
      ]
    },
    {
      "name": "temperature_sensor",
      "messages": [
        {
          "name": "coolant_temperature",
          "can_id": "0x300",
          "interval_ms": 500,
          "dlc": 3,
          "signals": [
            {"name": "coolant_temp_c", "start_byte": 0, "size": 1, "initial": 90, "min": 80, "max": 105, "max_step": 1}
          ],
          "counter_byte": 2
        }
      ]
    },
    {
      "name": "battery_monitor",
      "messages": [
        {
          "name": "battery_status",
          "can_id": "0x400",
          "interval_ms": 1000,
          "dlc": 5,
          "signals": [
            {"name": "voltage_decivolts", "start_byte": 0, "size": 2, "initial": 126, "min": 120, "max": 145, "max_step": 1},
            {"name": "charge_pct", "start_byte": 2, "size": 1, "initial": 80, "min": 20, "max": 100, "max_step": 1}
          ],
          "counter_byte": 4
        }
      ]
    }
  ]
}
